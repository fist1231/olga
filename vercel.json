{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/shop/p/:slug", "destination": "/shop/:slug", "permanent": true },
    { "source": "/about-1", "destination": "/about", "permanent": true },
    { "source": "/contact-1", "destination": "/contact", "permanent": true },
    { "source": "/framing-mounting", "destination": "/framing", "permanent": true },
    { "source": "/news", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
